   ]);
 });
+
+test('--active 按原顺序只列出未完成待办', () => {
+  const output = execFileSync(process.execPath, [entry, '--active'], { encoding: 'utf8' });
+  const [, ...items] = output.trim().split(/\r?\n/);
+
+  assert.deepEqual(items, ['[ ] 读懂 Git 差异', '[ ] 完成 Skills 实战']);
+});
+
+test('--active 在所有待办都完成时显示空结果提示', (context) => {
+  const fixture = mkdtempSync(join(tmpdir(), 'todo-workshop-'));
+  context.after(() => rmSync(fixture, { recursive: true, force: true }));
+
+  const fixtureEntry = join(fixture, 'todos.mjs');
+  copyFileSync(entry, fixtureEntry);
+  writeFileSync(join(fixture, 'todos.json'), JSON.stringify([
+    { title: '安装 Codex', completed: true },
+  ]));
+
+  const output = execFileSync(process.execPath, [fixtureEntry, '--active'], { encoding: 'utf8' });
+  assert.deepEqual(output.trim().split(/\r?\n/), ['待办清单', '没有未完成任务']);
+});
